# ---- Qdrant (required) ----------------------------------------------------
QDRANT_URL=https://<cluster-id>.<region>.gcp.cloud.qdrant.io
QDRANT_API_KEY=<rotate-the-key-that-was-pasted-in-chat>
POLICY_COLLECTION=policy_units_v2
FEATURE_COLLECTION=migration_payload



# ---- OpenAI: BOTH embeddings and answers ---------------------------------
# One key covers the whole pipeline when ANSWER_PROVIDER=openai.
OPENAI_API_KEY=

# Answer synthesis. Confirm the model string is available on this account and
# supports strict structured output (grounding depends on it):
#     python -m src.rag.cli verify-answer-model
ANSWER_PROVIDER=openai
OPENAI_ANSWER_MODEL=gpt-5.4-mini

# Query embedding. MUST be the model that built the collections. Stored vectors
# are 1536-dim, which both text-embedding-3-small and text-embedding-ada-002
# satisfy, so dimension agreement is NOT proof. Confirm with:
#     python -m src.rag.cli verify-embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Anthropic (optional) ------------------------------------------------
# Set ANSWER_PROVIDER=anthropic to use it. Stronger grounding: the API reports
# which document each cited span came from, and prompt caching makes follow-up
# questions on the same plan ~10x cheaper on input. See docs/rag-service.md.
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5
ANSWER_EFFORT=high

ANSWER_MAX_TOKENS=16000

# ---- retrieval tuning ---------------------------------------------------
SEARCH_TOP_K=24
MAX_PLANS=4
# NOTE: uncalibrated. Observed real scores ran 0.91-1.00, so this threshold
# does not currently fire. Calibrate against known-unanswerable questions.
MIN_SCORE=0.25

# ---- data-defect workarounds (see src/rag/canonical.py) -----------------
EXCLUDE_GROUP_CLIENT_SIDE=true
EXCLUDE_WITHDRAWN=true
# Arogya Sanjeevani / Saral Suraksha Bima are still sold; excluding them is a
# product decision, not a data fix.
EXCLUDE_MANDATED_STANDARD=false

LOG_LEVEL=INFO
